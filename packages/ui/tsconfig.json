{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist/types",
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
